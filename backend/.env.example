PORT=3000

# Railway/Postgres managed URL. Prefer this in production when available.
DATABASE_URL=
DB_SSL=true

# Local/manual Postgres configuration. Used when DATABASE_URL is empty.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Native Postgres variable names are also supported.
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Set to false only if migrations are run manually.
RUN_MIGRATIONS_ON_START=true
